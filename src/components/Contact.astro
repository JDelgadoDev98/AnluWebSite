---
const wa = 'https://wa.me/573218321960?text=' + encodeURIComponent('Hola SAC, quiero agendar una asesoría contable');
---
<section id="contacto" class="relative bg-gradient-to-br from-navy-900 via-navy-800 to-navy-950 text-white py-20 overflow-hidden">
  <div class="absolute -top-20 right-10 w-80 h-80 bg-sac-green-500/15 rounded-full blur-3xl"></div>
  <div class="relative max-w-4xl mx-auto px-4 text-center">
    <h2 class="font-display text-3xl md:text-4xl font-extrabold mb-4">
      ¿Listo para poner tu contabilidad <span class="text-sac-green-400">en orden</span>?
    </h2>
    <p class="text-navy-100 text-lg max-w-2xl mx-auto mb-8">
      Escríbenos por WhatsApp y te damos una asesoría inicial gratuita. Te ayudamos a elegir el plan ideal según tu negocio.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-white font-bold px-8 py-4 rounded-full text-lg transition-transform hover:scale-105 shadow-xl">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
        Escribir por WhatsApp
      </a>
      <a href="mailto:servicioscontableslunal@gmail.com" class="inline-block border-2 border-white/30 hover:border-sac-green-400 hover:text-sac-green-300 font-bold px-8 py-4 rounded-full text-lg transition-all">
        Enviar un correo
      </a>
    </div>
    <p class="text-navy-300 text-sm mt-8">Atención virtual en toda Colombia · Horario de lunes a viernes</p>
  </div>
</section>
