---
const year = new Date().getFullYear();
---
<footer class="bg-navy-950 text-navy-300 py-12">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="text-center md:text-left">
        <div class="bg-white rounded-xl p-3 inline-block">
          <img src="/images/logo-sac.jpg" alt="SAC — Servicios Administrativos y Contables" class="h-16 w-auto" width="64" height="64" />
        </div>
        <p class="text-sm mt-3 text-navy-400 max-w-xs">Soluciones contables y administrativas para tu tranquilidad.</p>
      </div>

      <nav class="flex flex-col sm:flex-row gap-x-8 gap-y-2 text-sm">
        <a href="#servicios" class="hover:text-sac-green-400 transition-colors">Servicios</a>
        <a href="#paquetes" class="hover:text-sac-green-400 transition-colors">Paquetes</a>
        <a href="#adicionales" class="hover:text-sac-green-400 transition-colors">Adicionales</a>
        <a href="#nosotros" class="hover:text-sac-green-400 transition-colors">Nosotros</a>
        <a href="#contacto" class="hover:text-sac-green-400 transition-colors">Contacto</a>
      </nav>
    </div>

    <div class="border-t border-navy-800 mt-10 pt-6 text-center text-xs text-navy-500">
      <p>&copy; {year} SAC — Servicios Administrativos y Contables. Todos los derechos reservados.</p>
      <p class="mt-1">Presentado por Ana María Luna.</p>
    </div>
  </div>
</footer>
